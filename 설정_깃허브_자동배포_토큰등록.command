#!/bin/bash

# =============================================================================
# [GitHub 스마트폰 자동 배포 1회성 토큰 설정 런처]
# 더블클릭 시 setup_github_token.py 가 실행됩니다.
# =============================================================================

cd "$(dirname "$0")"

python3 "setup_github_token.py"

echo ""
echo "아무 키나 누르면 창이 닫힙니다..."
read -n 1

